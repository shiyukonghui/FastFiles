{
  "$schema": "https://raw.githubusercontent.com/nicedoc/nicedoc.github.io/main/jsonschema/tauri-2.schema.json",
  "productName": "FastFiles",
  "version": "0.1.3",
  "identifier": "com.fastfiles.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FastFiles - 局域网文件传输",
        "width": 800,
        "height": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "plugins": {
    "dialog": null
  }
}
